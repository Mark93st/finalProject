{
  "name": "student-management-application",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npm run copy:htmx",
    "build:css": "tailwindcss -i ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/output.css --minify",
    "watch": "tailwindcss -i ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/output.css --watch",
    "copy:htmx": "copyfiles -f node_modules/htmx.org/dist/htmx.min.js src/main/resources/static/js/"
  },
  "dependencies": {
    "htmx.org": "^1.9.10"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.17",
    "copyfiles": "^2.4.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}